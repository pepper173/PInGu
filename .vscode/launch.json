    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "name": "Launch frontend",
            "preLaunchTask": "npm: start",
            "url": "http://localhost:4200",
            "webRoot": "${workspaceFolder}/frontend",
            "tmpDir": "${workspaceFolder}/.vscode/firefox-tmp/",
        },
    ]
}